{
  "rewrites": [
    { "source": "/data/:path*", "destination": "https://<your-blob-store>.public.blob.vercel-storage.com/:path*" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/((?!assets/|data/|api/).*)", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }] }
  ]
}
